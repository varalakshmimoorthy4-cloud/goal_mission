# Copy this file to ".env" in the project root (goal-mission/.env) and edit it.
# NEVER commit your real .env file or share your API key.

# --- Flask ---------------------------------------------------------------
# A long random string used to sign login tokens.
# If left as the placeholder (or empty), a random key is generated once and
# stored in backend/instance/secret_key.txt (fine for local demos).
SECRET_KEY=change-me-to-a-long-random-string
FLASK_DEBUG=1
PORT=5000

# --- Database ------------------------------------------------------------
# Leave empty to use SQLite at backend/goal_mission.db
DATABASE_URL=

# --- Claude AI -----------------------------------------------------------
# Get a key at https://console.anthropic.com/ . Leave as the placeholder to run
# WITHOUT AI (the app then shows clearly labelled non-AI template responses).
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Model name used for all AI features. Check the Anthropic docs for current names.
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_MAX_TOKENS=2500
CLAUDE_TIMEOUT_SECONDS=45

# --- CORS / misc ---------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to 0 to disable the "Try demo mode" button/endpoint.
ENABLE_DEMO_MODE=1
